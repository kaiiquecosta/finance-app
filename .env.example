# ─── Frontend (Vite) ─────────────────────────────────────────────
# Estas chaves são PÚBLICAS por natureza (expostas no cliente).
# A segurança real vem do RLS no Supabase, não de esconder estas chaves.

# Supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Stripe (apenas a publishable key vai no frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Comunidade — e-mails com permissão de admin (separados por vírgula)
# VITE_ADMIN_EMAILS=voce@exemplo.com,outro@exemplo.com

# Observabilidade (recomendado antes do lançamento)
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ─── Backend (Supabase Edge Functions) ───────────────────────────
# NUNCA colocar estas no frontend. Configurar via `supabase secrets set`.
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
