# ─── Frontend (Vite) ─────────────────────────────────────────────
# Estas chaves são PÚBLICAS por natureza (expostas no cliente).
# A segurança real vem do RLS no Supabase, não de esconder estas chaves.

# Supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Só para scripts de manutenção (NUNCA no frontend / Vite)
# SUPABASE_ACCESS_TOKEN=sbp_...   # https://supabase.com/dashboard/account/tokens
# SUPABASE_PROJECT_REF=your_project_ref

# Persona fictícia (local / preview)
# VITE_DEMO_PERSONA=true
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Open Finance (Pluggy) — modo no CLIENTE; segredos só no Supabase
# off | personal (Meu Pluggy) | sandbox | commercial (Connect widget)
# VITE_OPEN_FINANCE_MODE=personal
# Exige Pro/trial para sandbox/commercial no app (além da Edge Function)
# VITE_OPEN_FINANCE_PRO_ONLY=true

# ─── Backend (Supabase Edge Functions) ───────────────────────────
# NUNCA colocar estas no frontend. Configurar via `supabase secrets set`.
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PLUGGY_CLIENT_ID=...
# PLUGGY_CLIENT_SECRET=...
